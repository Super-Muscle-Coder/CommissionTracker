{
  "name": "commission-tracker-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Commission Tracker — interface layer (React renderer, organized by iWCA)",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "lint:style": "stylelint --max-warnings 0 \"src/**/*.css\"",
    "lint:layer": "node scripts/check_layer.mjs",
    "lint:contrast": "node scripts/check_contrast.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run lint:style && npm run lint:contrast && npm run lint:layer && npm run test",
    "e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts",
    "walkthrough:app": "npm run build && node tests/tools/walkthrough_app.mjs",
    "walkthrough:backend": "node tests/tools/walkthrough_backend.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "stylelint": "17.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
