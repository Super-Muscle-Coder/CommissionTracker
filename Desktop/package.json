{
  "name": "commission-tracker",
  "productName": "Commission Tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Commission Tracker — desktop layer (Electron main process)",
  "author": "TGN",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && playwright test",
    "lint": "eslint .",
    "probe": "npm run build && node tests/probe.cjs",
    "dist": "npm run build && node packaging/prepare_runtime.mjs && electron-builder --win nsis --x64",
    "test:packaged": "playwright test -c playwright.packaged.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
