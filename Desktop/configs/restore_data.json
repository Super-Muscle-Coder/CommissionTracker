    "validation": 400,
    "not_found": 404,
    "incompatible_backup": 409,
    "safety_backup_failed": 424,
    "storage_io": 500,
    "service_unavailable": 503
  },
  "error_codes": {
    "validation": "ERR_VALIDATION",
    "not_found": "ERR_NOT_FOUND",
    "incompatible_backup": "ERR_INCOMPATIBLE_BACKUP",
